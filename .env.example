# Local-safe defaults. Do not put secrets in this file.
NODE_ENV=development
BEATVAULT_HOST=127.0.0.1
BEATVAULT_PORT=4174
BEATVAULT_CORS_ORIGINS=http://localhost:5173
BEATVAULT_COOKIE_SECURE=false
BEATVAULT_COOKIE_SAMESITE=Lax
BEATVAULT_SESSION_TTL_SECONDS=28800
BEATVAULT_RATE_LIMIT=5
BEATVAULT_RATE_WINDOW_MS=60000
BEATVAULT_DATA_DIR=data/server-local
# json is the safe default. Set postgres only after starting Docker and applying migrations.
BEATVAULT_STORAGE_BACKEND=json
DATABASE_URL=postgresql://beatvault:beatvault_local_only@localhost:5432/beatvault
BEATVAULT_DB_MAX_CONNECTIONS=10
BEATVAULT_DB_IDLE_TIMEOUT_MS=10000
BEATVAULT_DB_CONNECTION_TIMEOUT_MS=5000
BEATVAULT_DEMO_ENABLED=true
BEATVAULT_DEMO_EMAIL=demo@beatvault.local
# BEATVAULT_DEMO_PASSWORD=use-a-local-password-of-at-least-12-chars
