# Local server configuration
# VITE_API_BASE_URL=              # default: same-origin /api, recommended for cookies/CSRF
# BEATVAULT_API_PROXY=http://127.0.0.1:4174 # Vite development proxy target
# BEATVAULT_ADMIN_EMAIL=
# BEATVAULT_ADMIN_PASSWORD=      # 12-128 characters; never commit a value
# BEATVAULT_ADMIN_BOOTSTRAP_TOKEN= # at least 32 characters; required by admin:bootstrap
# NODE_ENV=development
# BEATVAULT_DEV_AUTH_TOKENS=true # local development only; exposes one-time auth tokens in API responses
# BEATVAULT_STORAGE_BACKEND=json
# DATABASE_URL=                   # required only with BEATVAULT_STORAGE_BACKEND=postgres
# BEATVAULT_UPLOAD_DIR=data/uploads
# BEATVAULT_UPLOAD_MAX_FILE_BYTES=524288000
# BEATVAULT_UPLOAD_MAX_REQUEST_BYTES=534773760
# BEATVAULT_UPLOAD_MAX_FILES=1     # first version: one file/request
# BEATVAULT_UPLOAD_MAX_FIELDS=8
# Plan storage caps stay unset until the team approves capacities; values are bytes.
# BEATVAULT_PLAN_FREE_STORAGE_BYTES=
# BEATVAULT_PLAN_CREATOR_STORAGE_BYTES=
# BEATVAULT_PLAN_STUDIO_STORAGE_BYTES=
# Mercado Pago Split 1:1 / Checkout Pro is local/test-only. Never use VITE_ prefixes.
# Configure an HTTPS tunnel to the local web server (Vite proxies /api to the API).
# Add the same HTTPS origin to CORS and open BeatVault through that host for OAuth cookies.
# BEATVAULT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5187,http://127.0.0.1:5188,https://your-temporary-https-host.example
# BEATVAULT_PUBLIC_URL=https://your-temporary-https-host.example
# BEATVAULT_COOKIE_SECURE=true          # required when using the HTTPS tunnel
# BEATVAULT_DEMO_ENABLED=false          # required when using the HTTPS tunnel
# BEATVAULT_DEV_AUTH_TOKENS=false       # never expose dev-only recovery tokens through a tunnel
# BEATVAULT_SOCIAL_EVIDENCE_QUOTA_BYTES=1073741824 # shared 1 GiB cap for retained Story report evidence
# MERCADOPAGO_CLIENT_ID=                 # Application ID from a Mercado Pago Marketplace app
# MERCADOPAGO_CLIENT_SECRET=             # server-side only
# MERCADOPAGO_WEBHOOK_SECRET=             # Webhooks secret from the MP app settings
# BEATVAULT_MP_TOKEN_ENCRYPTION_KEY=      # base64 for 32 random bytes; generate locally with Node crypto
# BEATVAULT_MP_USD_MXN_RATE=              # explicit server-side quote; checkout stays disabled if unset
# BEATVAULT_MP_MARKETPLACE_FEE_BPS=       # explicit platform commission; checkout stays disabled if unset
