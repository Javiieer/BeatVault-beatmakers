{
  "name": "beatvault",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "server:test": "vitest run server --pool forks --maxWorkers 2",
    "test:postgres": "tsx scripts/postgres-qa.ts",
    "test:plan-capacity": "tsx scripts/plan-capacity-bots.ts",
    "admin:bootstrap": "tsx server/admin-bootstrap.ts",
    "local:qa-accounts": "tsx scripts/setup-local-qa-accounts.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report artifacts/playwright-report",
    "test:qa-bots": "npm run server:test && playwright test tests/chat.spec.ts tests/persistent-uploads.spec.ts tests/settings.spec.ts tests/creator-profile.spec.ts tests/profile-menu.spec.ts tests/feature-shots.spec.ts tests/site-audit.spec.ts tests/theme-route-audit.spec.ts",
    "test:security": "vitest run server/security-probes.test.ts",
    "diagnose": "tsx scripts/diagnose.ts",
    "diagnose:full": "tsx scripts/diagnose.ts --browser"
  },
  "dependencies": {
    "@types/busboy": "^1.5.4",
    "@vitejs/plugin-react": "latest",
    "busboy": "^1.6.0",
    "lucide-react": "^1.39.0",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "jsdom": "^30.0.1",
    "tsx": "latest",
    "typescript-eslint": "^8.68.0",
    "vitest": "latest"
  }
}
